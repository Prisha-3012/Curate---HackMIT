# Copy to .env and fill in. Nothing here is needed while DEMO_MODE=on.
# cp .env.example .env

# --- demo safety (§6) -------------------------------------------------------
# "on"  -> every route returns a fixture, no network, replays in <100ms
# "off" -> live pipeline
DEMO_MODE=on

# Seeded demo user. §4 requires user_id on POST /api/mission but no endpoint
# creates one, so it comes from seed/load.py.
DEMO_USER_ID=00000000-0000-0000-0000-000000000001

# --- step 7: decompose.py ---------------------------------------------------
# Either provider works — decompose.py speaks the OpenAI chat-completions
# protocol and xAI implements it. XAI is preferred when both are set.
XAI_API_KEY=
OPENAI_API_KEY=
# Optional overrides: 'xai' | 'openai' | 'auto' (default), and a model id.
LLM_PROVIDER=
LLM_MODEL=

# --- step 4: DB layer -------------------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=

# --- step 8: checkout -------------------------------------------------------
# Cybersource sandbox. Signup is the long pole (§8 puts it in hours 0-1.5) —
# start it early, approval is not instant.
CYBERSOURCE_MERCHANT_ID=
CYBERSOURCE_KEY_ID=
CYBERSOURCE_SECRET_KEY=
# Sandbox host: apitest.cybersource.com  (production: api.cybersource.com)
CYBERSOURCE_ENVIRONMENT=

# Stripe test mode — §8's documented fallback when Cybersource doesn't land.
# Test key starts sk_test_; never a live key in this repo.
STRIPE_SECRET_KEY=

# --- step 9: voice ----------------------------------------------------------
DEEPGRAM_API_KEY=
