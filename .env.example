# Copy to .env and fill in. Nothing here is needed while DEMO_MODE=on.
# cp .env.example .env

# --- demo safety (§6) -------------------------------------------------------
# "on"  -> every route returns a fixture, no network, replays in <100ms
# "off" -> live pipeline
DEMO_MODE=on

# Seeded demo user. §4 requires user_id on POST /api/mission but no endpoint
# creates one, so it comes from seed/load.py.
DEMO_USER_ID=00000000-0000-0000-0000-000000000001

# --- step 7: decompose.py — goal_text -> needs -------------------------------
# THIS IS THE ONLY LLM CALL IN THE BACKEND. One call per mission. Without a
# working key the decomposer falls back to the seeded WARDROBE needs for every
# goal, and the plan is honestly labelled source="fixture". Nothing breaks; the
# demo just stops being goal-driven. DEMO_MODE=on never calls an LLM at all.
#
# Set ONE of these three. All speak the OpenAI chat-completions protocol.
#
# Groq — https://console.groq.com/keys  (free tier, generous limits; start here)
GROQ_API_KEY=
# Gemini — https://aistudio.google.com/apikey  (free tier is 20 requests PER DAY
# per model, which rehearsal burns through fast; fine as a second option)
GEMINI_API_KEY=
# OpenAI — https://platform.openai.com/api-keys  (needs purchased credits)
OPENAI_API_KEY=
# xAI — https://console.x.ai  (needs purchased credits)
XAI_API_KEY=
#
# Optional. Provider: 'groq' | 'gemini' | 'openai' | 'xai' | 'auto' (default).
# auto takes the first key that is set, in that order.
LLM_PROVIDER=
# Optional. Overrides the provider's default model id. Set this if the default
# is not available to your key — a wrong id shows up as a 404 in the logs and a
# silent fall back to fixture needs.
LLM_MODEL=
# Optional. Seconds before the decompose call gives up (default 20). Gemini
# takes 6-9s for a real decomposition; too low and EVERY goal silently falls
# back to the seeded wardrobe needs, which looks exactly like a missing key.
LLM_TIMEOUT_S=

# --- step 4: DB layer -------------------------------------------------------
# OPTIONAL. Without these, reads fall back to seed/data/*.json (44 listings) and
# missions are not persisted, so GET /api/mission/{id} rebuilds instead of
# replaying. /health reports which path is live under "data_source".
#
# To turn it on:  https://supabase.com  -> new project -> Settings > API
#   1. run seed/migrations/001_init.sql then 002_freeform_categories.sql
#   2. set the two values below
#   3. uv run python -m seed.load          (--check validates without writing)
#
# Note this changes WHERE the listings live, not what they are: the same seeded
# rows, in Postgres. It does not add real marketplace inventory.
SUPABASE_URL=
SUPABASE_KEY=

# --- step 8: checkout -------------------------------------------------------
# Cybersource sandbox. Signup is the long pole (§8 puts it in hours 0-1.5) —
# start it early, approval is not instant.
CYBERSOURCE_MERCHANT_ID=
CYBERSOURCE_KEY_ID=
CYBERSOURCE_SECRET_KEY=
# Sandbox host: apitest.cybersource.com  (production: api.cybersource.com)
CYBERSOURCE_ENVIRONMENT=

# Stripe test mode — §8's documented fallback when Cybersource doesn't land.
# Test key starts sk_test_; never a live key in this repo.
STRIPE_SECRET_KEY=

# --- step 9: voice ----------------------------------------------------------
DEEPGRAM_API_KEY=
